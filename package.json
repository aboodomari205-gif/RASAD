{
  "name": "firepulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.ts\" \"server/*.test.js\"",
    "test:e2e": "node scripts/verify-motion.mjs",
    "test:filters": "node scripts/verify-filters.mjs",
    "test:language": "node scripts/verify-language.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "prepare:data": "node deployment/cloudflare/prepare-data.mjs",
    "build:cloudflare": "tsc -b && node deployment/cloudflare/build-pages.mjs && node scripts/verify-prepared-static.mjs",
    "preview:cloudflare": "node deployment/cloudflare/serve-static.mjs dist",
    "verify:static": "node scripts/verify-prepared-static.mjs",
    "test:static": "node scripts/verify-pages-preview.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "maplibre-gl": "^6.16.0",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
